# ==============================================
# ROOT .gitignore — MERN Task Manager
# ==============================================

# ---- Node Modules (all levels) ----
node_modules/
**/node_modules/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---- Environment / Secrets (NEVER commit these) ----
.env
.env.local
.env.production
.env.staging
.env.test
**/.env
**/.env.local
**/.env.production

# ---- Frontend Build Output ----
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ---- OS Files ----
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.bak

# ---- Temporary / Cache ----
*.tmp
*.temp
.cache/
.parcel-cache/

# ---- MongoDB Memory Server Cache ----
.mongodb/
mongodb-binaries/
